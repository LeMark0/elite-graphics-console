<Window x:Class="EliteGraphics.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Elite Graphics Console" Width="1440" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="#111925" BorderBrush="#303743" BorderThickness="0,0,0,1" Padding="26,18"><Grid><StackPanel><TextBlock Text="ELITE  /  GRAPHICS CONSOLE" FontSize="24" FontWeight="SemiBold" Foreground="#FFAD4D"/><TextBlock Text="Your flight. Your rendering. Every revision preserved." Margin="0,5,0,0" Style="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#142E32" CornerRadius="4" Padding="12,7" Margin="0,0,18,8"><TextBlock Text="VR  ·  VIRTUAL DESKTOP / VDXR" Foreground="#88DBCE" FontSize="11"/></Border><Button Content="Paths" Click="Paths_Click"/><Button Content="Refresh live" Click="Refresh_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#101722" BorderBrush="#293241" BorderThickness="0,0,1,0" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="PROFILE LIBRARY" Foreground="#93A4B9" FontSize="11" FontWeight="Bold" Margin="0,5,0,14"/><WrapPanel><Button Content="All" Tag="ALL" Click="Filter_Click" Padding="12,6"/><Button Content="VR" Tag="VR" Click="Filter_Click" Padding="12,6"/><Button Content="Flat" Tag="FLAT" Click="Filter_Click" Padding="12,6"/></WrapPanel></StackPanel>
    <ListBox x:Name="ProfilesList" Grid.Row="1" SelectionChanged="Profile_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Mode}" Foreground="#FFAD4D" FontSize="11"/><TextBlock Text="{Binding Number,StringFormat='  /  REV {0:000}'}" Foreground="#9CABBE" FontSize="11"/></StackPanel><TextBlock Text="{Binding Status}" Foreground="#8DA0B7" Margin="0,4,0,0" FontSize="11"/><TextBlock Text="PROTECTED BASELINE" Foreground="#86C7BE" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Protected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><Button Content="＋  Capture current" Click="Capture_Click" HorizontalContentAlignment="Left"/><Button Content="Import graphics folder" Click="Import_Click"/><Button Content="Migrate historical profile" Click="Migrate_Click"/><Button Content="Export selected revision" Click="Export_Click"/><Button Content="Advanced XML editor" Click="Advanced_Click"/><TextBlock Text="All revisions are immutable. Saving edits creates a new revision." Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="26,20,26,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="ProfileTitle" Text="Welcome aboard" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ProfileSubtitle" Text="Capture your current graphics to begin." Style="{StaticResource Muted}" Margin="0,6,0,14"/><Border Background="#172432" Padding="12" CornerRadius="4" Margin="0,0,0,10"><TextBlock x:Name="LiveStatus" Text="Reading live graphics…" Foreground="#88DBCE"/></Border></StackPanel>
    <TabControl Grid.Row="1" x:Name="MainTabs">
     <TabItem Header="CONFIGURE"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,14,0">
       <UniformGrid Columns="4" Margin="0,0,0,18"><Border Background="#1B2635" CornerRadius="5" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="PLANET TEXTURE" Style="{StaticResource Muted}"/><TextBlock x:Name="PlanetCard" Text="—" FontSize="29" Foreground="#FFAD4D"/><TextBlock x:Name="PlanetSource" Style="{StaticResource Muted}"/></StackPanel></Border><Border Background="#1B2635" CornerRadius="5" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="GALAXY BACKGROUND" Style="{StaticResource Muted}"/><TextBlock x:Name="GalaxyCard" Text="—" FontSize="29" Foreground="#FFAD4D"/><TextBlock x:Name="GalaxySource" Style="{StaticResource Muted}"/></StackPanel></Border><Border Background="#1B2635" CornerRadius="5" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="HMD IMAGE QUALITY" Style="{StaticResource Muted}"/><TextBlock x:Name="HmdCard" Text="—" FontSize="29"/><TextBlock Text="Game render multiplier" Style="{StaticResource Muted}"/></StackPanel></Border><Border Background="#1B2635" CornerRadius="5" Padding="15"><StackPanel><TextBlock Text="SUPERSAMPLING" Style="{StaticResource Muted}"/><TextBlock x:Name="SsCard" Text="—" FontSize="29"/><TextBlock Text="Separate from VD quality" Style="{StaticResource Muted}"/></StackPanel></Border></UniformGrid>
       <Border Background="#141D29" Padding="18" CornerRadius="5"><StackPanel><TextBlock Text="EDIT A NEW REVISION" FontWeight="SemiBold" Foreground="#FFAD4D" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Profile name"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Display mode"/><ComboBox x:Name="ModeBox"/></StackPanel></Grid>
       <UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="Planet texture size"/><ComboBox x:Name="PlanetBox"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Galaxy background size"/><ComboBox x:Name="GalaxyBox"/></StackPanel><StackPanel><TextBlock Text="Environment quality"/><ComboBox x:Name="EnvironmentBox" ToolTip="Changing this also selects planet, background and decal tiers. Texture overrides below target the resulting tier."/></StackPanel></UniformGrid>
       <UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="HMD image quality"/><TextBox x:Name="HmdBox"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Supersampling"/><TextBox x:Name="SsBox"/></StackPanel><StackPanel><TextBlock Text="Model draw distance (0–1)"/><TextBox x:Name="LodBox"/></StackPanel></UniformGrid>
       <Expander Header="Terrain, lighting and display" Foreground="#BFCDE0" Margin="0,4,0,12"><StackPanel Margin="0,14,0,0"><UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="Terrain quality"/><ComboBox x:Name="TerrainBox"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Ambient occlusion"/><ComboBox x:Name="AoBox"/></StackPanel><StackPanel><TextBlock Text="Terrain work (0–1)"/><TextBox x:Name="WorkBox"/></StackPanel></UniformGrid><UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="Directional shadows (0–4)"/><TextBox x:Name="ShadowBox"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Spot shadows (0–4)"/><TextBox x:Name="SpotBox"/></StackPanel><StackPanel><TextBlock Text="Volumetrics"/><ComboBox x:Name="VolumetricBox"/></StackPanel></UniformGrid><UniformGrid Columns="3"><StackPanel Margin="0,0,16,0"><TextBlock Text="Desktop width"/><TextBox x:Name="WidthBox"/></StackPanel><StackPanel Margin="0,0,16,0"><TextBlock Text="Desktop height"/><TextBox x:Name="HeightBox"/></StackPanel><StackPanel><TextBlock Text="Desktop FPS limit"/><TextBox x:Name="FpsBox"/></StackPanel></UniformGrid><WrapPanel><CheckBox x:Name="VsyncBox" Content="Desktop VSync" Margin="0,5,25,8"/><CheckBox x:Name="LimitBox" Content="Desktop frame limiter"/></WrapPanel></StackPanel></Expander>
       <TextBlock Text="Revision notes"/><TextBox x:Name="NotesBox" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap"/>
       <TextBlock x:Name="WarningsText" Foreground="#BDAB89" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
      </StackPanel></ScrollViewer>
      <WrapPanel Grid.Row="1" Margin="0,16,0,0"><Button Content="Save new revision" Style="{StaticResource Primary}" Click="Save_Click"/><Button Content="Create 4096 planets + galaxy" Click="HiRes_Click"/><Button Content="Review &amp; apply selected" Click="Apply_Click"/><Button Content="Restore previous apply" Click="Restore_Click"/></WrapPanel>
     </Grid></TabItem>
     <TabItem Header="COMPARE"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Expander Header="SELECT PRESETS TO COMPARE — collapse to enlarge the table" IsExpanded="True" Foreground="#FFAD4D" FontWeight="SemiBold">
       <ListBox x:Name="ComparePresets" SelectionMode="Multiple" MaxHeight="155" SelectionChanged="Compare_Changed"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><CheckBox IsHitTestVisible="False" Focusable="False" Margin="0" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem},Mode=OneWay}"><TextBlock Text="{Binding DisplayName}"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Expander>
      <WrapPanel Grid.Row="1" Margin="0,12,0,0"><CheckBox x:Name="OnlyDifferences" Content="Differences only" IsChecked="True" Checked="CompareOptions_Changed" Unchecked="CompareOptions_Changed" Margin="0,8,22,8"/><CheckBox x:Name="RawComparison" Content="Raw XML / all overrides" Checked="CompareOptions_Changed" Unchecked="CompareOptions_Changed" Margin="0,8,22,8"/><Button Content="Select current VR presets" Click="SelectVrComparisons_Click"/><Button Content="Clear selection" Click="ClearComparisons_Click"/></WrapPanel>
      <TextBlock x:Name="CompareSummary" Grid.Row="2" Foreground="#88DBCE" Margin="0,0,0,12"/>
      <DataGrid x:Name="DiffGrid" Grid.Row="3" FrozenColumnCount="1" HorizontalScrollBarVisibility="Auto" CanUserReorderColumns="False"/>
     </Grid></TabItem>
     <TabItem Header="BENCHMARKS"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="RECORDED RUNS" Foreground="#93A4B9" FontSize="11" Margin="0,0,0,12"/><Button Content="Open run folder" Click="RunFolder_Click"/></StackPanel><ListBox x:Name="RunsList" Grid.Row="1" DisplayMemberPath="DisplayName" SelectionChanged="Run_Selected"/></Grid>
       <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="Performance flight recorder" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Automatic GPU telemetry · manual VD observations · flat-screen frame import" Style="{StaticResource Muted}" Margin="0,6,0,16"/><TextBlock Text="Scenario / route"/><TextBox x:Name="ScenarioBox" Text="Orbital approach"/><WrapPanel><Button x:Name="RecordButton" Content="Start capture  Ctrl+Shift+B" Style="{StaticResource Primary}" Click="Record_Click"/><Button Content="Mark checkpoint  Ctrl+Shift+M" Click="Mark_Click"/></WrapPanel><TextBlock x:Name="RecordingText" Text="Ready. The selected revision must match the live files." Foreground="#88DBCE" Margin="0,0,0,14"/>
       <Border Background="#141F2D" Padding="14" CornerRadius="5"><StackPanel><TextBlock Text="GPU MEMORY  /  MiB  /  whole GPU" Foreground="#95A8BD" FontSize="11"/><Canvas x:Name="MemoryChart" Height="140" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/><TextBlock x:Name="RunSummary" Text="No recorded samples." Foreground="#CED8E6"/></StackPanel></Border>
       <TextBlock Text="Runtime settings (manual unless explicitly verified)" Margin="0,16,0,0"/><TextBox x:Name="RuntimeBox" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Text="Virtual Desktop / VDXR; quality: unknown; Hz: unknown; SSW: unknown; codec: unknown; bitrate: unknown"/>
       <TextBlock Text="VD overlay observations / checkpoint readings"/><TextBox x:Name="OverlayBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Visual notes / clarity / hitches"/><TextBox x:Name="VisualBox" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><Button Content="Save run notes" Click="SaveRun_Click"/><Button Content="Attach screenshot" Click="Screenshot_Click"/><Button Content="Import FLAT PresentMon CSV" Click="ImportFrames_Click"/></WrapPanel><TextBlock Text="Compare with another run"/><ComboBox x:Name="RunCompareBox" DisplayMemberPath="DisplayName" SelectionChanged="RunCompare_Changed"/><TextBlock x:Name="RunDelta" Foreground="#D3B985"/>
       <TextBlock Text="VR frame timing and continuous SSW capture are not validated in v1. GPU samples cannot measure individual hitches; desktop mirror FPS is not headset FPS." Foreground="#9AAAC0" FontSize="12" Margin="0,18,0,10"/></StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="FLIGHT CHECKLIST"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="A sharper view, a stable flight." FontSize="25" Foreground="#FFAD4D" Margin="0,0,0,20"/><TextBlock FontSize="15" LineHeight="26" Text="1. Preserve the baseline. All edits create new revisions; the original files are retained byte for byte.&#10;&#10;2. Review the effective tier. A 4096 entry under Ultra does nothing while Medium is selected. This app targets the tier selected by your saved environment quality.&#10;&#10;3. Save, compare, then apply with Elite closed. A preview shows every managed-file change. Rollback restores only the files affected by that apply.&#10;&#10;4. Keep Virtual Desktop, OpenComposite and VDXR fixed. This app never changes the VR runtime, driver profiles or graphics-mod DLLs.&#10;&#10;5. Test the same route. Use a fixed space view, orbital approach, and stationary planet view. Capture initial texture arrival separately from warmed-up performance.&#10;&#10;6. Compare baseline / candidate, then candidate / baseline. Record VD quality, refresh, SSW, codec and bitrate for every run. Look for sharper details without extra hitches or reprojection.&#10;&#10;7. Confirm in the headset. 72 Hz can include generated SSW frames. One-second GPU measurements show load and VRAM trends, not per-frame smoothness."/><Button Content="Open local library" Click="LibraryFolder_Click" Margin="0,24,0,10" HorizontalAlignment="Left"/><TextBlock Text="No cloud sync. Profile snapshots and benchmark data stay on this computer unless you explicitly export them. Not affiliated with Frontier Developments." Style="{StaticResource Muted}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#141D29" Padding="20,7"><Grid><TextBlock x:Name="StatusText" Text="LOCAL LIBRARY  /  SETTINGS UNCHANGED" FontSize="11" Foreground="#9BACBF"/><TextBlock Text="ELITE GRAPHICS CONSOLE  /  1.1.0" FontSize="11" HorizontalAlignment="Right" Foreground="#74889E"/></Grid></Border>
 </Grid>
</Window>
