<Window x:Class="EliteGraphics.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#090B0C" Foreground="#ECE5D9" Style="{StaticResource {x:Type Window}}" Title="Elite Graphics Console" Width="1440" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
  <Border Background="#090B0C" BorderBrush="#65411E" BorderThickness="0,0,0,1" Padding="20,12"><Grid><StackPanel><TextBlock Text="ELITE  /  GRAPHICS CONSOLE" FontSize="21" FontWeight="SemiBold" Foreground="#FF9600"/><TextBlock Text="PRESETS  /  GRAPHICS  /  PERFORMANCE" Margin="0,5,0,0" Style="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="#17110B" CornerRadius="0" Padding="12,7" Margin="0,0,18,8"><TextBlock Text="LOCAL PROFILE MANAGER" Foreground="#63CCE3" FontSize="11"/></Border><Button Content="Paths" Click="Paths_Click"/><Button Content="Check applied status" Click="Refresh_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#100E0B" BorderBrush="#65411E" BorderThickness="0,0,1,0" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><Button Content="LOAD CURRENT SETTINGS…" Click="LoadCurrent_Click" ToolTip="Read saved game settings into an unsaved workspace"/><TextBlock Text="PRESET LIBRARY" Foreground="#B8AA98" FontSize="11" FontWeight="Bold" Margin="0,5,0,14"/><DockPanel><Button x:Name="NewPresetButton" DockPanel.Dock="Right" Width="34" Height="34" Padding="0" Margin="0,0,0,8" VerticalAlignment="Top" AutomationProperties.Name="Create preset" ToolTip="Create preset from current settings, game defaults, or a saved preset" Click="NewPreset_Click"><Path Width="12" Height="12" Data="M 6,0 L 6,12 M 0,6 L 12,6" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button><WrapPanel><Button Content="All" Tag="ALL" Click="Filter_Click" Height="34" Padding="12,0"/><Button Content="VR" Tag="VR" Click="Filter_Click" Height="34" Padding="12,0"/><Button Content="Flat" Tag="FLAT" Click="Filter_Click" Height="34" Padding="12,0"/></WrapPanel></DockPanel></StackPanel>
    <ListBox x:Name="ProfilesList" Grid.Row="1" SelectionChanged="Profile_Selected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="{Binding Mode}" FontSize="11"/><TextBlock Text="{Binding Number,StringFormat='  /  REV {0:000}'}" FontSize="11"/></StackPanel><TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="11"/><TextBlock Text="PROTECTED BASELINE" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Protected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><Expander Header="LIBRARY TOOLS" Foreground="{StaticResource Amber}"><StackPanel Margin="0,10,0,0"><Button Content="Import graphics folder" Click="Import_Click"/><Button Content="Migrate historical profile" Click="Migrate_Click"/><Button Content="Export selected revision" Click="Export_Click"/></StackPanel></Expander></StackPanel>
   </Grid></Border>
   <Grid Grid.Column="1" Margin="20,16,20,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><DockPanel><StackPanel DockPanel.Dock="Right" Margin="16,0,0,0"><Border x:Name="AppliedBadge" Background="#65411E" CornerRadius="0" Padding="12,6" Margin="0,0,8,6"><TextBlock x:Name="AppliedLabel" Text="STATUS UNKNOWN" FontWeight="Bold" HorizontalAlignment="Center"/></Border><Button x:Name="HeaderApplyButton" Content="Apply preset" Style="{StaticResource Primary}" Click="Apply_Click" IsEnabled="False"/></StackPanel><StackPanel><TextBlock x:Name="ProfileTitle" Text="Welcome aboard" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="ProfileSubtitle" Text="Capture your current graphics to begin." Style="{StaticResource Muted}" Margin="0,6,0,14"/></StackPanel></DockPanel><Border Background="#17110B" Padding="12" CornerRadius="0" Margin="0,0,0,10"><TextBlock x:Name="LiveStatus" Text="Checking saved game settings…" Foreground="#63CCE3" TextWrapping="Wrap"/></Border>      <StackPanel><TextBlock x:Name="DirtyStatus" Foreground="#FF9600" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><WrapPanel Margin="0,8,0,0"><Button x:Name="SaveCurrentButton" Content="Save as preset" Style="{StaticResource Primary}" Click="SaveCurrent_Click" Visibility="Collapsed"/><Button x:Name="UpdatePresetButton" Content="Update this preset" Style="{StaticResource Primary}" Click="UpdatePreset_Click" IsEnabled="False"/><Button x:Name="ForkPresetButton" Content="Fork this preset" Click="ForkPreset_Click"/><Button x:Name="DiscardButton" Content="Discard changes" Click="DiscardPreset_Click" IsEnabled="False"/><Menu Margin="0,0,0,8"><MenuItem Header="MORE"><MenuItem Header="History" Click="History_Click"/><MenuItem Header="Set both textures to 4096" Click="HiRes_Click"/><MenuItem Header="Advanced XML editor" Click="Advanced_Click"/><Separator/><MenuItem Header="Restore previous apply" Click="Restore_Click"/><MenuItem x:Name="DeletePresetButton" Header="Delete preset…" Click="DeletePreset_Click"/></MenuItem></Menu></WrapPanel></StackPanel></StackPanel>
    <TabControl Grid.Row="1" x:Name="MainTabs">
     <!-- Private compatibility controls for the existing validated draft mapper. -->
     <TabItem x:Name="LegacyControls" Visibility="Collapsed" IsEnabled="False"><StackPanel>
       <TextBlock x:Name="PlanetCard"/>
       <TextBlock x:Name="PlanetSource"/>
       <TextBlock x:Name="GalaxyCard"/>
       <TextBlock x:Name="GalaxySource"/>
       <TextBlock x:Name="HmdCard"/>
       <TextBlock x:Name="SsCard"/>
       <TextBox x:Name="NameBox"/>
       <ComboBox x:Name="ModeBox"/>
       <ComboBox x:Name="PlanetBox"/>
       <ComboBox x:Name="GalaxyBox"/>
       <ComboBox x:Name="EnvironmentBox"/>
       <TextBox x:Name="HmdBox"/>
       <TextBox x:Name="SsBox"/>
       <TextBox x:Name="LodBox"/>
       <ComboBox x:Name="TerrainBox"/>
       <ComboBox x:Name="AoBox"/>
       <TextBox x:Name="WorkBox"/>
       <TextBox x:Name="ShadowBox"/>
       <TextBox x:Name="SpotBox"/>
       <ComboBox x:Name="VolumetricBox"/>
       <TextBox x:Name="WidthBox"/>
       <TextBox x:Name="HeightBox"/>
       <TextBox x:Name="FpsBox"/>
       <CheckBox x:Name="VsyncBox"/>
       <CheckBox x:Name="LimitBox"/>
       <TextBox x:Name="NotesBox"/>
       <TextBlock x:Name="WarningsText"/>
     </StackPanel></TabItem>
     <TabItem x:Name="ConfigureTab" Header="SETTINGS">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
        <TextBox x:Name="SettingsSearch" TextChanged="SettingsSearch_Changed" ToolTip="Search settings, values, sources or XML paths" AutomationProperties.Name="Search settings" Margin="0,0,12,8"/>
        <ComboBox x:Name="CategoryBox" Grid.Column="1" SelectionChanged="Category_Changed" SelectedIndex="0" Margin="0,0,0,8"><ComboBoxItem Content="All categories"/><ComboBoxItem Content="VR / RENDERING"/><ComboBoxItem Content="PLANETS / GALAXY"/><ComboBoxItem Content="TERRAIN"/><ComboBoxItem Content="LIGHTING / EFFECTS"/><ComboBoxItem Content="DISPLAY"/><ComboBoxItem Content="HUD"/><ComboBoxItem Content="ADVANCED / OTHER"/></ComboBox>
       </Grid>
       <WrapPanel Grid.Row="1"><CheckBox x:Name="InspectOlder" Content="Older schemas" Checked="InventoryOptions_Changed" Unchecked="InventoryOptions_Changed" Margin="0,0,18,8"/><CheckBox x:Name="InspectDefaults" Content="Definition references" Checked="InventoryOptions_Changed" Unchecked="InventoryOptions_Changed" Margin="0,0,18,8"/><TextBlock Text="Enter: commit · Esc: cancel edit" Style="{StaticResource Muted}"/></WrapPanel>
       <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <DataGrid x:Name="SettingsGrid" HorizontalScrollBarVisibility="Disabled" SizeChanged="SettingsGrid_SizeChanged" SelectionChanged="Setting_Selected" SelectionMode="Single" SelectionUnit="FullRow" CanUserSortColumns="False" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
         <DataGrid.GroupStyle><GroupStyle/></DataGrid.GroupStyle>
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="SETTING" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate>
           <StackPanel Margin="8,4,10,5"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Entry.Description}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" Margin="0,4,0,0"/></StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="VALUE" Width="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
           <StackPanel>
            <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
             <Button Style="{StaticResource TriangleButton}" Tag="-1" IsEnabled="{Binding HasChoices}" Visibility="{Binding ArrowVisibility}" Click="StepSetting_Click" ToolTip="Previous value" AutomationProperties.Name="Previous value"><Path Data="M 7,0 L 0,5 L 7,10 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
             <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Input,Mode=OneWay}" Visibility="{Binding ChoiceVisibility}" SelectionChanged="InlineChoice_Changed" PreviewMouseWheel="InlineChoice_Wheel" IsEnabled="{Binding Editable}" Margin="0" Padding="4,2" MinHeight="29" AutomationProperties.Name="{Binding Entry.Setting}"/>
             <TextBox Grid.Column="1" Text="{Binding Input,UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding TextVisibility}" IsReadOnly="{Binding ReadOnly}" PreviewKeyDown="Inline_KeyDown" LostKeyboardFocus="Inline_LostFocus" GotKeyboardFocus="Inline_Focus" Margin="0" Padding="5,2" MinHeight="29" ToolTip="{Binding Entry.DisplayValue}" AutomationProperties.Name="{Binding Entry.Setting}"/>
             <TextBlock Grid.Column="1" Text="{Binding Entry.DisplayValue}" Visibility="{Binding ReferenceVisibility}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,2" ToolTip="{Binding Entry.Value}"/>
             <Button Grid.Column="2" Style="{StaticResource TriangleButton}" Tag="1" IsEnabled="{Binding HasChoices}" Visibility="{Binding ArrowVisibility}" Click="StepSetting_Click" ToolTip="Next value" AutomationProperties.Name="Next value"><Path Data="M 0,0 L 7,5 L 0,10 Z" Fill="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
            </Grid><TextBlock Text="{Binding Error}" Foreground="#FF6655" FontSize="11" Margin="28,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
           </StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Column="1" BorderBrush="#65411E" BorderThickness="1,0,0,0" Margin="16,0,0,0" Padding="14,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
         <TextBlock x:Name="DetailTitle" Text="SETTING DETAILS" Foreground="{StaticResource Amber}" FontSize="14" Margin="0,4,0,14"/>
         <TextBlock x:Name="DetailNote" Style="{StaticResource Muted}" Margin="0,0,0,16"/>
         <TextBlock Text="SAVED / CAPTURED" Foreground="{StaticResource Amber}" FontSize="11"/><TextBlock x:Name="DetailSaved" Foreground="#ECE5D9" Margin="0,4,0,12"/>
         <TextBlock Text="DRAFT" Foreground="{StaticResource Amber}" FontSize="11"/><TextBlock x:Name="DetailDraft" Foreground="#ECE5D9" Margin="0,4,0,12"/>
         <TextBlock Text="SOURCE" Foreground="{StaticResource Amber}" FontSize="11"/><TextBlock x:Name="DetailSource" Style="{StaticResource Muted}" Margin="0,4,0,12"/>
         <TextBlock Text="XML PATH / RAW VALUE" Foreground="{StaticResource Amber}" FontSize="11"/><TextBlock x:Name="DetailPath" Foreground="#B8AA98" FontFamily="Consolas" FontSize="11" Margin="0,4,0,16"/>
         <Button x:Name="ResetSettingButton" Content="RESET VALUE" Click="ResetSetting_Click" IsEnabled="False"/>
         <Expander Header="Revision notes" Foreground="{StaticResource Amber}" Margin="0,12,0,0"><TextBox x:Name="TerminalNotes" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="TerminalNotes_Changed"/></Expander>
        </StackPanel></ScrollViewer></Border>
       </Grid>
       <TextBlock x:Name="InventorySummary" Grid.Row="3" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
      </Grid>
     </TabItem>
     <TabItem Header="COMPARE"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Expander Header="SELECT PRESETS TO COMPARE — collapse to enlarge the table" IsExpanded="True" Foreground="#FF9600" FontWeight="SemiBold">
       <ListBox x:Name="ComparePresets" SelectionMode="Multiple" MaxHeight="155" SelectionChanged="Compare_Changed"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><CheckBox Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" IsHitTestVisible="False" Focusable="False" Margin="0" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem},Mode=OneWay}"><TextBlock Text="{Binding DisplayName}"/></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox>
      </Expander>
      <WrapPanel Grid.Row="1" Margin="0,12,0,0"><CheckBox x:Name="OnlyDifferences" Content="Differences only" IsChecked="True" Checked="CompareOptions_Changed" Unchecked="CompareOptions_Changed" Margin="0,8,22,8"/><CheckBox x:Name="RawComparison" Content="Raw XML / all overrides" Checked="CompareOptions_Changed" Unchecked="CompareOptions_Changed" Margin="0,8,22,8"/><Button Content="Select current VR presets" Click="SelectVrComparisons_Click"/><Button Content="Clear selection" Click="ClearComparisons_Click"/></WrapPanel>
      <TextBlock x:Name="CompareSummary" Grid.Row="2" Foreground="#63CCE3" Margin="0,0,0,12"/>
      <DataGrid x:Name="DiffGrid" Grid.Row="3" FrozenColumnCount="1" HorizontalScrollBarVisibility="Auto" CanUserReorderColumns="False"/>
     </Grid></TabItem>
     <TabItem Header="BENCHMARKS"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="RECORDED RUNS" Foreground="#B8AA98" FontSize="11" Margin="0,0,0,12"/><Button Content="Open run folder" Click="RunFolder_Click"/></StackPanel><ListBox x:Name="RunsList" Grid.Row="1" DisplayMemberPath="DisplayName" SelectionChanged="Run_Selected"/></Grid>
       <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="Performance flight recorder" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Automatic GPU telemetry · manual VD observations · flat-screen frame import" Style="{StaticResource Muted}" Margin="0,6,0,16"/><TextBlock Text="Scenario / route"/><TextBox x:Name="ScenarioBox" Text="Orbital approach"/><WrapPanel><Button x:Name="RecordButton" Content="Start capture  Ctrl+Shift+B" Style="{StaticResource Primary}" Click="Record_Click"/><Button Content="Mark checkpoint  Ctrl+Shift+M" Click="Mark_Click"/></WrapPanel><TextBlock x:Name="RecordingText" Text="Ready. The selected revision must match the live files." Foreground="#63CCE3" Margin="0,0,0,14"/>
       <Border Background="#17110B" Padding="14" CornerRadius="0"><StackPanel><TextBlock Text="GPU MEMORY  /  MiB  /  whole GPU" Foreground="#B8AA98" FontSize="11"/><Canvas x:Name="MemoryChart" Height="140" ClipToBounds="True" SizeChanged="Chart_SizeChanged"/><TextBlock x:Name="RunSummary" Text="No recorded samples." Foreground="#ECE5D9"/></StackPanel></Border>
       <TextBlock Text="Runtime settings (manual unless explicitly verified)" Margin="0,16,0,0"/><TextBox x:Name="RuntimeBox" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" Text="Virtual Desktop / VDXR; quality: unknown; Hz: unknown; SSW: unknown; codec: unknown; bitrate: unknown"/>
       <TextBlock Text="VD overlay observations / checkpoint readings"/><TextBox x:Name="OverlayBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="Visual notes / clarity / hitches"/><TextBox x:Name="VisualBox" MinHeight="65" AcceptsReturn="True" TextWrapping="Wrap"/><WrapPanel><Button Content="Save run notes" Click="SaveRun_Click"/><Button Content="Attach screenshot" Click="Screenshot_Click"/><Button Content="Import FLAT PresentMon CSV" Click="ImportFrames_Click"/></WrapPanel><TextBlock Text="Compare with another run"/><ComboBox x:Name="RunCompareBox" DisplayMemberPath="DisplayName" SelectionChanged="RunCompare_Changed"/><TextBlock x:Name="RunDelta" Foreground="#D9AB71"/>
       <TextBlock Text="VR frame timing and continuous SSW capture are not validated in v1. GPU samples cannot measure individual hitches; desktop mirror FPS is not headset FPS." Foreground="#B8AA98" FontSize="12" Margin="0,18,0,10"/></StackPanel></ScrollViewer>
      </Grid></TabItem>
      <TabItem Header="FLIGHT CHECKLIST"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="A sharper view, a stable flight." FontSize="25" Foreground="#FF9600" Margin="0,0,0,20"/><TextBlock FontSize="15" LineHeight="26" Text="1. Preserve the baseline. All edits create new revisions; the original files are retained byte for byte.&#10;&#10;2. Review the effective tier. A 4096 entry under Ultra does nothing while Medium is selected. This app targets the tier selected by your saved environment quality.&#10;&#10;3. Save, compare, then apply with Elite closed. A preview shows every managed-file change. Rollback restores only the files affected by that apply.&#10;&#10;4. Keep Virtual Desktop, OpenComposite and VDXR fixed. This app never changes the VR runtime, driver profiles or graphics-mod DLLs.&#10;&#10;5. Test the same route. Use a fixed space view, orbital approach, and stationary planet view. Capture initial texture arrival separately from warmed-up performance.&#10;&#10;6. Compare baseline / candidate, then candidate / baseline. Record VD quality, refresh, SSW, codec and bitrate for every run. Look for sharper details without extra hitches or reprojection.&#10;&#10;7. Confirm in the headset. 72 Hz can include generated SSW frames. One-second GPU measurements show load and VRAM trends, not per-frame smoothness."/><Button Content="Open local library" Click="LibraryFolder_Click" Margin="0,24,0,10" HorizontalAlignment="Left"/><TextBlock Text="No cloud sync. Profile snapshots and benchmark data stay on this computer unless you explicitly export them. Not affiliated with Frontier Developments." Style="{StaticResource Muted}"/></StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="#17110B" Padding="20,7"><Grid><TextBlock x:Name="StatusText" Text="LOCAL LIBRARY  /  SETTINGS UNCHANGED" FontSize="11" Foreground="#B8AA98"/><TextBlock Text="ELITE GRAPHICS CONSOLE  /  1.7.0" FontSize="11" HorizontalAlignment="Right" Foreground="#B8AA98"/></Grid></Border>
 </Grid>
</Window>
