<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF9600"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#160E00"/>
  <SolidColorBrush x:Key="Amber" Color="#FF9600"/><SolidColorBrush x:Key="Ink" Color="#090B0C"/><SolidColorBrush x:Key="Panel" Color="#17110B"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#25190C"/><SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECE5D9"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF9600"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#160E00"/>
  <Style TargetType="Window"><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="Background" Value="{StaticResource Ink}"/><Setter Property="Foreground" Value="#ECE5D9"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E7B372"/><Setter Property="Background" Value="#34220F"/><Setter Property="BorderBrush" Value="#85521C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#63CCE3"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Amber}"/><Setter Property="Foreground" Value="#18130C"/><Setter Property="BorderBrush" Value="{StaticResource Amber}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#100E0B"/><Setter Property="Foreground" Value="#E7B372"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#85521C"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,2,0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#E7B372"/><Setter Property="Background" Value="#25190C"/><Setter Property="BorderBrush" Value="#85521C"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,2,0,6"/><Setter Property="MinHeight" Value="30"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#25190C" BorderBrush="#85521C" BorderThickness="1" CornerRadius="0"><Path Data="M 0,0 L 10,0 L 5,6 Z" Fill="{StaticResource Amber}" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,7,28,7" VerticalAlignment="Center"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#25190C" BorderBrush="#85521C" BorderThickness="1" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="350"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E7B372"/><Setter Property="Padding" Value="10,7"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECE5D9"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#ECE5D9"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
